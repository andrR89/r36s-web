+def save_path(raw_path):
+    """Caminho em disco de /r36s/saves/<sistema>/<arquivo>, ou None se inválido (fora de saves/, '..', subpastas)."""
+    parts = raw_path[len(SAVES_PREFIX):].split("/")
+    if len(parts) != 2:
+        return None
+    system, name = (urllib.parse.unquote(x) for x in parts)
+    if not SAVES_SYSTEM.match(system) or not name or name.startswith(".") or "/" in name or "\\" in name or "\0" in name:
+        return None
+    return os.path.join(BASE, "r36s", "saves", system, name)
+

From ceebe045f0181452ea69e965e5d164edfa8c398b Mon Sep 17 00:00:00 2001
From: andrR89 <3686269+andrR89@users.noreply.github.com>
Date: Fri, 16 Oct 2026 16:04:25 -0300
Subject: [PATCH 4/5] web: texto (ALPHA->RGBA) e glifos vazios no GL1 emulado

---
 es-core/src/renderers/Renderer_GLES10.cpp | 40 +++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/es-core/src/renderers/Renderer_GLES10.cpp b/es-core/src/renderers/Renderer_GLES10.cpp
index c047c8e..142e4c2 100644
--- a/es-core/src/renderers/Renderer_GLES10.cpp
+++ b/es-core/src/renderers/Renderer_GLES10.cpp
@@ -150,9 +150,36 @@ namespace Renderer
 		input = nullptr;
 	} // destroyContext
 
+#ifdef _WEB_
+	// O GL1 emulado do emscripten amostra GL_ALPHA como (0,0,0,a) em vez de (Cf, Af*At):
+	// o texto (atlas de glifos em ALPHA) saía preto. Expande para RGBA branco + alfa.
+	static std::vector<unsigned char> sAlphaExpand;
+	static void* webExpandAlpha(const Texture::Type _type, const unsigned int _width, const unsigned int _height, void* _data)
+	{
+		if (_type != Texture::ALPHA || _data == nullptr)
+			return _data;
+		const size_t n = (size_t)_width * _height;
+		sAlphaExpand.resize(n * 4);
+		const unsigned char* src = (const unsigned char*)_data;
+		for (size_t i = 0; i < n; i++)
+		{
+			sAlphaExpand[i * 4 + 0] = 255;
+			sAlphaExpand[i * 4 + 1] = 255;
+			sAlphaExpand[i * 4 + 2] = 255;
+			sAlphaExpand[i * 4 + 3] = src[i];
+		}
+		return sAlphaExpand.data();
+	}
+#endif
+
 	unsigned int createTexture(const Texture::Type _type, const bool _linear, const bool _repeat, const unsigned int _width, const unsigned int _height, void* _data)
 	{
+#ifdef _WEB_
+		const GLenum type = GL_RGBA;
+		_data = webExpandAlpha(_type, _width, _height, _data);
+#else
 		const GLenum type = convertTextureType(_type);
+#endif
 		unsigned int texture;
 
 		glGenTextures(1, &texture);
@@ -183,6 +210,18 @@ namespace Renderer
 	{
 		bindTexture(_texture);
 
+#ifdef _WEB_
+		if (_data == nullptr && !(_x == -1 && _y == -1))
+		{
+			bindTexture(0); // glifo vazio (ex.: espaço): WebGL rejeita texSubImage2D sem pixels
+			return;
+		}
+		_data = webExpandAlpha(_type, _width, _height, _data);
+		if (_x == -1 && _y == -1)
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, _width, _height, 0, GL_RGBA, GL_UNSIGNED_BYTE, _data);
+		else
+			glTexSubImage2D(GL_TEXTURE_2D, 0, _x, _y, _width, _height, GL_RGBA, GL_UNSIGNED_BYTE, _data);
+#else
 		if (_x == -1 && _y == -1)
 		{
 			const GLenum type = convertTextureType(_type);
@@ -190,6 +229,7 @@ namespace Renderer
 		}
 		else
 			glTexSubImage2D(GL_TEXTURE_2D, 0, _x, _y, _width, _height, convertTextureType(_type), GL_UNSIGNED_BYTE, _data);
+#endif
 
 		bindTexture(0);
 

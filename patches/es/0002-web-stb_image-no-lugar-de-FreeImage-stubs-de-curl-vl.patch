+// tela do R36S: 640x480 em paisagem; o libgo2 reporta o painel em retrato (480x640)
+#define WEB_W 640
+#define WEB_H 480
+
+struct go2_display { int dummy; };
+struct go2_surface { int width, height, stride; uint16_t* pixels; bool isContextSurface; };
+struct go2_context { SDL_Window* window; SDL_GLContext gl; go2_surface_t surface; };
+struct go2_presenter { int dummy; };
+
+static uint32_t s_volume = 100;
+static uint32_t s_backlight = 100;
+static GLuint s_titleTex = 0;
+
+static void writeTextFile(const std::string& path, const std::string& text)
+{
+	std::string dir;
+	for (size_t i = 1; i < path.size(); i++)
+		if (path[i] == '/') { dir = path.substr(0, i); mkdir(dir.c_str(), 0755); }
+	FILE* f = fopen(path.c_str(), "w");
+	if (f) { fputs(text.c_str(), f); fclose(f); }
+}
+
+static bool fileExists(const char* path) { struct stat st; return stat(path, &st) == 0; }
+
+extern "C" {
+
+go2_display_t* go2_display_create(void)
+{
+	// sysfs que a barra de título do ArkOS lê (Renderer_GLES10::swapBuffers)
+	if (!fileExists("/sys/class/power_supply/battery/capacity")) writeTextFile("/sys/class/power_supply/battery/capacity", "100\n");
+	if (!fileExists("/sys/class/power_supply/ac/online")) writeTextFile("/sys/class/power_supply/ac/online", "0\n");
+	if (!fileExists("/sys/class/net/wlan0/operstate")) writeTextFile("/sys/class/net/wlan0/operstate", "down\n");
+	go2_display_backlight_set(NULL, s_backlight);
+	SDL_InitSubSystem(SDL_INIT_VIDEO);
+	return (go2_display_t*)calloc(1, sizeof(go2_display_t));
+}
+
+void go2_display_destroy(go2_display_t* display) { free(display); }
+int go2_display_width_get(go2_display_t*) { return WEB_H; }
+int go2_display_height_get(go2_display_t*) { return WEB_W; }
+uint32_t go2_display_backlight_get(go2_display_t*) { return s_backlight; }
+void go2_display_backlight_set(go2_display_t*, uint32_t value)
+{
+	if (value > 100) value = 100;
+	s_backlight = value;
+	writeTextFile("/sys/class/backlight/backlight/brightness", std::to_string(value * 255 / 100) + "\n");
+	EM_ASM({ if (Module.onBacklight) Module.onBacklight($0); }, value);
+}
+
+go2_surface_t* go2_surface_create(go2_display_t*, int width, int height, uint32_t)
+{
+	go2_surface_t* s = (go2_surface_t*)calloc(1, sizeof(go2_surface_t));
+	s->width = width; s->height = height; s->stride = width * 2;
+	s->pixels = (uint16_t*)calloc((size_t)width * height, 2);
+	return s;
+}
+
+void go2_surface_destroy(go2_surface_t* s)
+{
+	if (!s || s->isContextSurface) return;
+	free(s->pixels);
+	free(s);
+}
+
+void* go2_surface_map(go2_surface_t* s) { return s->pixels; }
+int go2_surface_stride_get(go2_surface_t* s) { return s->stride; }
+
+// desenha uma superfície RGB565 no framebuffer GL atual, em coordenadas de janela (origem no topo)
+void go2_surface_blit(go2_surface_t* src, int srcX, int srcY, int srcWidth, int srcHeight,
+                      go2_surface_t* dst, int dstX, int dstY, int dstWidth, int dstHeight, go2_rotation_t)
+{
+	if (!src || !dst || !dst->isContextSurface || srcWidth <= 0 || srcHeight <= 0) return;
+
+	// RGB565 -> RGBA (a textura do GL1 emulado aceita RGBA/UNSIGNED_BYTE sem surpresas)
+	static unsigned char* rgba = nullptr;
+	static size_t rgbaSize = 0;
+	size_t need = (size_t)srcWidth * srcHeight * 4;
+	if (need > rgbaSize) { free(rgba); rgba = (unsigned char*)malloc(need); rgbaSize = need; }
+	for (int y = 0; y < srcHeight; y++)
+	{
+		const uint16_t* row = (const uint16_t*)((const uint8_t*)src->pixels + (size_t)(srcY + y) * src->stride) + srcX;
+		unsigned char* out = rgba + (size_t)y * srcWidth * 4;
+		for (int x = 0; x < srcWidth; x++)
+		{
+			uint16_t c = row[x];
+			out[x * 4 + 0] = (unsigned char)(((c >> 11) & 0x1F) * 255 / 31);
+			out[x * 4 + 1] = (unsigned char)(((c >> 5) & 0x3F) * 255 / 63);
+			out[x * 4 + 2] = (unsigned char)((c & 0x1F) * 255 / 31);
+			out[x * 4 + 3] = 255;
+		}
+	}
+
+	if (!s_titleTex) glGenTextures(1, &s_titleTex);
+
+	GLint vp[4]; glGetIntegerv(GL_VIEWPORT, vp);
+	GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+	GLboolean blend = glIsEnabled(GL_BLEND);
+
+	glBindTexture(GL_TEXTURE_2D, s_titleTex);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, srcWidth, srcHeight, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+	glEnable(GL_TEXTURE_2D);
+	glDisable(GL_SCISSOR_TEST);
+	glDisable(GL_BLEND);
+
+	glViewport(0, 0, dst->width, dst->height);
+	glMatrixMode(GL_PROJECTION); glPushMatrix(); glLoadIdentity();
+	glOrthof(0, (float)dst->width, (float)dst->height, 0, -1, 1);
+	glMatrixMode(GL_MODELVIEW); glPushMatrix(); glLoadIdentity();
+
+	const float x0 = (float)dstX, y0 = (float)dstY, x1 = (float)(dstX + dstWidth), y1 = (float)(dstY + dstHeight);
+	const GLfloat pos[] = { x0, y0, x0, y1, x1, y0, x1, y1 };
+	const GLfloat tex[] = { 0, 0, 0, 1, 1, 0, 1, 1 };
+	glColor4f(1, 1, 1, 1);
+	glEnableClientState(GL_VERTEX_ARRAY);
+	glEnableClientState(GL_TEXTURE_COORD_ARRAY);
+	glVertexPointer(2, GL_FLOAT, 0, pos);
+	glTexCoordPointer(2, GL_FLOAT, 0, tex);
+	glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+	glDisableClientState(GL_TEXTURE_COORD_ARRAY);
+	glDisableClientState(GL_VERTEX_ARRAY);
+
+	glMatrixMode(GL_PROJECTION); glPopMatrix();
+	glMatrixMode(GL_MODELVIEW); glPopMatrix();
+	glViewport(vp[0], vp[1], vp[2], vp[3]);
+	if (scissor) glEnable(GL_SCISSOR_TEST);
+	if (blend) glEnable(GL_BLEND);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	glDisable(GL_TEXTURE_2D);
+}
+
+go2_context_t* go2_context_create(go2_display_t*, int width, int height, const go2_context_attributes_t* attr)
+{
+	SDL_GL_SetAttribute(SDL_GL_RED_SIZE, attr->red_bits);
+	SDL_GL_SetAttribute(SDL_GL_GREEN_SIZE, attr->green_bits);
+	SDL_GL_SetAttribute(SDL_GL_BLUE_SIZE, attr->blue_bits);
+	SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, attr->depth_bits);
+	SDL_GL_SetAttribute(SDL_GL_STENCIL_SIZE, 8); // cantos arredondados usam stencil
+	SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+
+	go2_context_t* c = (go2_context_t*)calloc(1, sizeof(go2_context_t));
+	c->window = SDL_CreateWindow("EmulationStation", SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED, width, height, SDL_WINDOW_OPENGL);
+	if (!c->window) { fprintf(stderr, "go2_web: SDL_CreateWindow: %s\n", SDL_GetError()); return c; }
+	c->gl = SDL_GL_CreateContext(c->window);
+	if (!c->gl) fprintf(stderr, "go2_web: SDL_GL_CreateContext: %s\n", SDL_GetError());
+	c->surface.width = width;
+	c->surface.height = height;
+	c->surface.isContextSurface = true;
+	return c;
+}
+
+void go2_context_destroy(go2_context_t* c)
+{
+	if (!c) return;
+	if (c->gl) SDL_GL_DeleteContext(c->gl);
+	if (c->window) SDL_DestroyWindow(c->window);
+	free(c);
+}
+
+void go2_context_make_current(go2_context_t* c) { if (c && c->gl) SDL_GL_MakeCurrent(c->window, c->gl); }
+void go2_context_swap_buffers(go2_context_t*) { /* WebGL apresenta ao devolver o controle ao navegador */ }
+go2_surface_t* go2_context_surface_lock(go2_context_t* c) { return &c->surface; }
+void go2_context_surface_unlock(go2_context_t*, go2_surface_t*) {}
+
+go2_presenter_t* go2_presenter_create(go2_display_t*, uint32_t, uint32_t) { return (go2_presenter_t*)calloc(1, sizeof(go2_presenter_t)); }
+void go2_presenter_destroy(go2_presenter_t* p) { free(p); }
+
+// "post" = apresentar o quadro: cede ao navegador até o próximo frame (ASYNCIFY)
+void go2_presenter_post(go2_presenter_t*, go2_surface_t*, int, int, int, int, int, int, int, int, go2_rotation_t)
+{
+	web_wait_frame();
+}
+
+uint32_t go2_audio_volume_get(go2_audio_t*) { return s_volume; }
+void go2_audio_volume_set(go2_audio_t*, uint32_t value) { s_volume = value > 100 ? 100 : value; }
+
+} // extern "C"

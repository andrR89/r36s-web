+#ifdef _WEB_
+// stb_image no lugar de FreeImage. Mesma convenção de saída do FreeImage: RGBA, linha 0 = base da imagem.
+static unsigned char* webDecodeRGBA(const unsigned char* data, size_t size, int& w, int& h)
+{
+	int n = 0;
+	w = h = 0;
+	unsigned char* px = stbi_load_from_memory(data, (int)size, &w, &h, &n, 4);
+	if (px == nullptr)
+		LOG(LogError) << "Error - Failed to load image from memory! (" << stbi_failure_reason() << ")";
+	return px;
+}
+
+std::vector<unsigned char> ImageIO::loadFromMemoryRGBA32(const unsigned char * data, const size_t size, size_t & width, size_t & height)
+{
+	std::vector<unsigned char> rawData;
+	int w, h;
+	unsigned char* px = webDecodeRGBA(data, size, w, h);
+	width = 0; height = 0;
+	if (px == nullptr)
+		return rawData;
+	width = w; height = h;
+	rawData.assign(px, px + (size_t)w * h * 4);
+	stbi_image_free(px);
+	flipPixelsVert(rawData.data(), width, height);
+	return rawData;
+}
+#else
 std::vector<unsigned char> ImageIO::loadFromMemoryRGBA32(const unsigned char * data, const size_t size, size_t & width, size_t & height)

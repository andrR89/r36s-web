 }
 
+#ifdef _WEB_
+// redução por média de área (substitui FreeImage_Rescale FILTER_BOX)
+static unsigned char* webBoxResize(const unsigned char* src, int sw, int sh, int dw, int dh)
+{
+	unsigned char* dst = new unsigned char[(size_t)dw * dh * 4];
+	for (int y = 0; y < dh; y++)
+	{
+		int y0 = (int)((long long)y * sh / dh), y1 = (int)((long long)(y + 1) * sh / dh);
+		if (y1 <= y0) y1 = y0 + 1;
+		for (int x = 0; x < dw; x++)
+		{
+			int x0 = (int)((long long)x * sw / dw), x1 = (int)((long long)(x + 1) * sw / dw);
+			if (x1 <= x0) x1 = x0 + 1;
+			unsigned int acc[4] = { 0, 0, 0, 0 };
+			for (int yy = y0; yy < y1; yy++)
+				for (int xx = x0; xx < x1; xx++)
+				{
+					const unsigned char* p = src + ((size_t)yy * sw + xx) * 4;
+					acc[0] += p[0]; acc[1] += p[1]; acc[2] += p[2]; acc[3] += p[3];
+				}
+			unsigned int n = (unsigned int)((y1 - y0) * (x1 - x0));
+			unsigned char* q = dst + ((size_t)y * dw + x) * 4;
+			for (int c = 0; c < 4; c++) q[c] = (unsigned char)(acc[c] / n);
+		}
+	}
+	return dst;
+}
+
+unsigned char* ImageIO::loadFromMemoryRGBA32Ex(const unsigned char * data, const size_t size, size_t & width, size_t & height, int maxWidth, int maxHeight, bool externZoom, Vector2i& baseSize, Vector2i& packedSize)
+{
+	baseSize = Vector2i(0, 0);
+	packedSize = Vector2i(0, 0);
+	width = 0;
+	height = 0;
+
+	int w, h;
+	unsigned char* px = webDecodeRGBA(data, size, w, h);
+	if (px == nullptr)
+		return NULL;
+
+	baseSize = Vector2i(w, h);
+	unsigned char* out = nullptr;
+
+	if (maxWidth > 0 && maxHeight > 0 && (w > maxWidth || h > maxHeight))
+	{
+		Vector2i sz = adjustPictureSize(Vector2i(w, h), Vector2i(maxWidth, maxHeight), externZoom);
+		if (sz.x() > 0 && sz.y() > 0 && (sz.x() != w || sz.y() != h))
+		{
+			out = webBoxResize(px, w, h, sz.x(), sz.y());
+			w = sz.x(); h = sz.y();
+			packedSize = Vector2i(w, h);
+		}
+	}
+
+	if (out == nullptr)
+	{
+		out = new unsigned char[(size_t)w * h * 4];
+		memcpy(out, px, (size_t)w * h * 4);
+	}
+	stbi_image_free(px);
+
+	width = w;
+	height = h;
+	flipPixelsVert(out, width, height);
+	return out;
+}
+#else
 unsigned char* ImageIO::loadFromMemoryRGBA32Ex(const unsigned char * data, const size_t size, size_t & width, size_t & height, int maxWidth, int maxHeight, bool externZoom, Vector2i& baseSize, Vector2i& packedSize)
 {
 	baseSize = Vector2i(0, 0);
@@ -496,6 +597,8 @@ unsigned char* ImageIO::loadFromMemoryRGBA32Ex(const unsigned char * data, const
 	return NULL;

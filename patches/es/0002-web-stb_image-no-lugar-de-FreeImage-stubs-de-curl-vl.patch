diff --git a/es-core/src/web/WebFetch.cpp b/es-core/src/web/WebFetch.cpp
new file mode 100644
index 0000000..ccd09f6
--- /dev/null
+++ b/es-core/src/web/WebFetch.cpp
@@ -0,0 +1,21 @@
+#include "WebFetch.h"
+#include <emscripten.h>
+
+EM_ASYNC_JS(int, web_fetch_lazy_js, (const char* path), {
+	if (!Module.fetchLazy) return 0;
+	try { return await Module.fetchLazy(UTF8ToString(path)); }
+	catch (e) { console.warn("[r36s] fetchLazy", e); return 0; }
+});
+
+EM_ASYNC_JS(void, web_wait_frame_js, (), {
+	// rAF dá o ritmo do monitor; o setTimeout garante progresso se a aba estiver em segundo plano
+	await new Promise(resolve => {
+		let done = false;
+		const fin = () => { if (!done) { done = true; resolve(); } };
+		requestAnimationFrame(fin);
+		setTimeout(fin, 100);
+	});
+});
+
+extern "C" int web_fetch_lazy(const char* path) { return web_fetch_lazy_js(path); }
+extern "C" void web_wait_frame(void) { web_wait_frame_js(); }

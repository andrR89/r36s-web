Subject: [PATCH 1/6] =?UTF-8?q?web:=20op=C3=A7=C3=A3o=20WEB=20no=20CMake?=
 =?UTF-8?q?=20(ports=20emscripten,=20sem=20find=5Fpackage)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 CMakeLists.txt         | 23 +++++++++++++++++++++++
 es-core/CMakeLists.txt |  8 ++++++++
 2 files changed, 31 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a0c24a3..f6e8524 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4,6 +4,7 @@ option(GLES "Set to ON if targeting Embedded OpenGL" ${GLES})
 option(GL "Set to ON if targeting Desktop OpenGL" ${GL})
 option(RPI "Set to ON to enable the Raspberry PI video player (omxplayer)" ${RPI})
 option(CEC "Set to ON to enable CEC" ${CEC})
+option(WEB "Emscripten/WebAssembly build" OFF)
 
 project(emulationstation-all)
 
@@ -50,6 +51,18 @@ set_property(CACHE GLSystem PROPERTY STRINGS "Desktop OpenGL" "Embedded OpenGL")
 
 #finding necessary packages
 #-------------------------------------------------------------------------------
+if(WEB)
+    # Emscripten: SDL2, SDL2_mixer e FreeType vêm dos ports; GLES1 via LEGACY_GL_EMULATION;
+    # FreeImage -> stb_image; curl/VLC/ALSA/go2 -> stubs (ver es-core/src/web/)
+    add_definitions(-D_WEB_ -DSTBI_ONLY_PNG -DSTBI_ONLY_JPEG -DSTBI_ONLY_GIF)
+    set(WEB_PORTS "-sUSE_SDL=2 -sUSE_SDL_MIXER=2 -sSDL2_MIXER_FORMATS=[ogg,mp3,wav] -sUSE_FREETYPE=1")
+    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${WEB_PORTS} -O2")
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${WEB_PORTS} -std=gnu++17 -O2 -Wno-register -Wno-c++11-narrowing")
+    set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} ${WEB_PORTS} -O2 -sLEGACY_GL_EMULATION=1 -sGL_UNSAFE_OPTS=0 -sASYNCIFY=1 -sASYNCIFY_STACK_SIZE=1048576 -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=268435456 -sSTACK_SIZE=4194304 -sMODULARIZE=1 -sEXPORT_ES6=1 -sEXPORT_NAME=createES -sEXPORTED_RUNTIME_METHODS=[FS,ENV,callMain] -sINVOKE_RUN=0 -sEXIT_RUNTIME=0 -sFORCE_FILESYSTEM=1 -sENVIRONMENT=web -lidbfs.js")
+    set(CMAKE_EXECUTABLE_SUFFIX ".js")
+    set(RAPIDJSON_INCLUDE_DIRS ${RAPIDJSON_DIR})
+    set(WEB_INCLUDE_DIRS ${STB_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/es-core/src/web)
+else()
 if(${GLSystem} MATCHES "Desktop OpenGL")
     find_package(OpenGL REQUIRED)
 else()
@@ -77,6 +90,7 @@ endif()
 if(${CMAKE_SYSTEM_NAME} MATCHES "Linux")
     find_package(ALSA REQUIRED)
 endif()
+endif(WEB)
 
 #-------------------------------------------------------------------------------
 #set up compiler flags and excutable names
@@ -138,6 +152,7 @@ set(COMMON_INCLUDE_DIRS
     ${RAPIDJSON_INCLUDE_DIRS}
     ${CMAKE_CURRENT_SOURCE_DIR}/external
     ${CMAKE_CURRENT_SOURCE_DIR}/es-core/src
+    ${WEB_INCLUDE_DIRS}
 )
 
 if(DEFINED SCREENSCRAPER_SOFTNAME)
@@ -277,13 +292,21 @@ endif()
 
 #-------------------------------------------------------------------------------
 # set up build directories
+if(WEB)
+    set(dir ${CMAKE_CURRENT_BINARY_DIR})
+else()
 set(dir ${CMAKE_CURRENT_SOURCE_DIR})
+endif()
 set(EXECUTABLE_OUTPUT_PATH ${dir} CACHE PATH "Build directory" FORCE)
 set(LIBRARY_OUTPUT_PATH ${dir} CACHE PATH "Build directory" FORCE)
 
 
 #-------------------------------------------------------------------------------
 # add each component
+if(WEB)
+    # nada de FreeImage/curl/VLC/ALSA/EGL/go2: só as libs internas
+    set(COMMON_LIBRARIES pugixml nanosvg)
+endif()
 
 add_subdirectory("external")
 add_subdirectory("es-core")
diff --git a/es-core/CMakeLists.txt b/es-core/CMakeLists.txt
index ce60377..a0fac50 100644
--- a/es-core/CMakeLists.txt
+++ b/es-core/CMakeLists.txt
@@ -170,6 +170,14 @@ set(CORE_SOURCES
 	${CMAKE_CURRENT_SOURCE_DIR}/src/utils/AsyncUtil.cpp
 )
 
+if(WEB)
+	# shims do navegador: libgo2 (display/áudio), busca sob demanda, stubs de vlc/drm
+	list(APPEND CORE_SOURCES
+		${CMAKE_CURRENT_SOURCE_DIR}/src/web/go2_web.cpp
+		${CMAKE_CURRENT_SOURCE_DIR}/src/web/WebFetch.cpp
+	)
+endif()
+
 include_directories(${COMMON_INCLUDE_DIRS})
 add_library(es-core STATIC ${CORE_SOURCES} ${CORE_HEADERS} src/SystemConf.cpp src/SystemConf.h)
 target_link_libraries(es-core ${COMMON_LIBRARIES})
-- 

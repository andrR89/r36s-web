Date: Sat, 17 Oct 2026 19:20:41 -0300
Subject: [PATCH] web: avisa o JS a cada quadro completo (Module.r36sFrameDone)
 para cobrir buscas no meio do quadro

---
 es-core/src/web/WebFetch.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/es-core/src/web/WebFetch.cpp b/es-core/src/web/WebFetch.cpp
index ccd09f6..4517728 100644
--- a/es-core/src/web/WebFetch.cpp
+++ b/es-core/src/web/WebFetch.cpp
@@ -8,6 +8,9 @@ EM_ASYNC_JS(int, web_fetch_lazy_js, (const char* path), {
 });
 
 EM_ASYNC_JS(void, web_wait_frame_js, (), {
+	// quadro completo: o JS guarda uma cópia (web/fsboot.js), que cobre o canvas se uma busca sob demanda ceder ao
+	// navegador no meio do próximo quadro (senão ele mostra o quadro pela metade: tela preta piscando)
+	if (Module.r36sFrameDone) Module.r36sFrameDone();
 	// rAF dá o ritmo do monitor; o setTimeout garante progresso se a aba estiver em segundo plano
 	await new Promise(resolve => {
 		let done = false;
-- 

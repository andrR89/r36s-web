 es-core/src/platform.cpp | 46 ++++++++++++++++++++++++++++------------
 1 file changed, 33 insertions(+), 13 deletions(-)

diff --git a/es-core/src/platform.cpp b/es-core/src/platform.cpp
index cb9f26a..76e13d6 100644
--- a/es-core/src/platform.cpp
+++ b/es-core/src/platform.cpp
@@ -111,9 +111,19 @@ static std::string webShellUnescape(const std::string& s)
 	return out;
 }
 
+// argumento de shell começando em start: até um espaço ou ';' sem escape (o %ROM% vem escapado pelo getEscapedPath)
+static std::string webShellArg(const std::string& cmd, size_t start)
+{
+	size_t end = start;
+	while (end < cmd.size() && !((cmd[end] == ';' || cmd[end] == ' ') && (end == start || cmd[end - 1] != '\\'))) end++;
+	return webShellUnescape(cmd.substr(start, end - start));
+}
+
 // Comando real do dArkOS:
 //   sudo perfmax <gov> <rom>; nice -n -19 /usr/local/bin/<emu> -L /home/ark/.config/<emu>/cores/<core>_libretro.so <rom>; sudo perfnorm
-// -> núcleo = <core>, ROM = argumento depois do .so (até o "; "), sistema = pasta em /roms/<sistema>/
+// -> núcleo = <core>, ROM = argumento depois do .so, sistema = pasta em /roms/<sistema>/.
+// Outros comandos (scripts do dArkOS: n64.sh, drastic.sh, ppsspp.sh, ports...): núcleo vazio, ROM = primeiro argumento
+// em /roms/ — a ponte decide pelo sistema (web/data/cores.json) ou avisa que não há emulador no navegador.
 static bool webParseLaunch(const std::string& cmd, std::string& system, std::string& core, std::string& rom)
 {
 	if (cmd.rfind("web-launch ", 0) == 0)   // forma antiga da amostra: web-launch <sistema> <nucleo> <rom>
@@ -123,30 +133,40 @@ static bool webParseLaunch(const std::string& cmd, std::string& system, std::str
 		system = cmd.substr(11, a - 11); core = cmd.substr(a + 1, b - a - 1); rom = webShellUnescape(cmd.substr(b + 1));
 		return true;
 	}
+	core.clear(); rom.clear(); system.clear();
 	size_t so = cmd.find("_libretro.so ");
 	size_t cores = so == std::string::npos ? so : cmd.rfind("/cores/", so);
-	if (cores == std::string::npos) return false;
-	core = cmd.substr(cores + 7, so - cores - 7);
-	size_t start = so + 13, end = start;
-	while (end < cmd.size() && !(cmd[end] == ';' && (end == 0 || cmd[end - 1] != '\\'))) end++;   // ';' sem escape
-	std::string raw = cmd.substr(start, end - start);
-	while (!raw.empty() && raw.back() == ' ' && (raw.size() < 2 || raw[raw.size() - 2] != '\\')) raw.pop_back();
-	rom = webShellUnescape(raw);
-	if (rom.rfind("/roms/", 0) != 0) return false;
+	if (cores != std::string::npos)
+	{
+		core = cmd.substr(cores + 7, so - cores - 7);
+		size_t start = so + 13;
+		while (start < cmd.size() && cmd[start] == ' ') start++;
+		rom = webShellArg(cmd, start);
+	}
+	if (rom.rfind("/roms/", 0) != 0)
+	{
+		rom.clear();
+		for (size_t p = cmd.find("/roms/"); p != std::string::npos; p = cmd.find("/roms/", p + 1))
+			if (p == 0 || cmd[p - 1] == ' ' || cmd[p - 1] == '"' || cmd[p - 1] == '\'') { rom = webShellArg(cmd, p); break; }
+	}
+	if (rom.rfind("/roms/", 0) != 0) { rom.clear(); return false; }
 	size_t slash = rom.find('/', 6);
-	if (slash == std::string::npos) return false;
+	if (slash == std::string::npos) { rom.clear(); return false; }
 	system = rom.substr(6, slash - 6);
-	return !core.empty() && !system.empty();
+	return !system.empty();
 }
 #endif
 
 int runSystemCommand(const std::string& cmd_utf8, const std::string& name, Window* window)
 {
 #ifdef _WEB_
-	// comando de lançamento -> ponte JS (web/bridge.js). Outros comandos (scripts do dArkOS) são ignorados.
+	// lançamento de jogo (FileData::launchGame passa o nome do jogo) -> ponte JS (web/bridge.js), que avisa se o
+	// sistema não tem emulador no navegador. Outros comandos (scripts de evento, menus do dArkOS) são ignorados.
 	LOG(LogInfo) << "runSystemCommand (web): " << cmd_utf8;
 	std::string sysName, core, rom;
-	if (!webParseLaunch(cmd_utf8, sysName, core, rom))
+	if (name.empty())
+		return 0;
+	if (!webParseLaunch(cmd_utf8, sysName, core, rom) && cmd_utf8.rfind("web-launch ", 0) == 0)
 		return 0;
 	LOG(LogInfo) << "web launch: system=" << sysName << " core=" << core << " rom=" << rom;
 	if (window != NULL)

<!-- r36s-demo: tema mínimo do modo demonstração do R36S Web (cores do site). Autoria própria, mesma licença do
     projeto; fonte Press Start 2P (SIL OFL 1.1, _art/OFL-PressStart2P.txt). -->
<theme>
	<formatVersion>4</formatVersion>
	<view name="system">
		<image name="background" extra="true">
			<path>./_art/bg.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="band" extra="true">
			<path>./_art/panel.png</path>
			<pos>0 0.33</pos>
			<size>1 0.3</size>
			<zIndex>5</zIndex>
		</image>
		<image name="stripe" extra="true">
			<path>./_art/bar.png</path>
			<pos>0 0.63</pos>
			<size>1 0.012</size>
			<zIndex>5</zIndex>
		</image>
		<text name="title" extra="true">
			<text>R36S WEB · DEMO</text>
			<pos>0.05 0.08</pos>
			<size>0.9 0.08</size>
			<fontPath>./_art/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<color>ffd23fff</color>
			<alignment>left</alignment>
			<zIndex>10</zIndex>
		</text>
		<carousel name="systemcarousel">
			<type>horizontal</type>
			<pos>0 0.33</pos>
			<size>1 0.3</size>
			<color>00000000</color>
			<logoSize>0.42 0.2</logoSize>
			<maxLogoCount>3</maxLogoCount>
			<logoScale>1.15</logoScale>
			<zIndex>20</zIndex>
		</carousel>
		<text name="logoText">
			<fontPath>./_art/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.05</fontSize>
			<color>ece6ffff</color>
		</text>
		<text name="systemInfo">
			<pos>0 0.66</pos>
			<size>1 0.07</size>
			<fontSize>0.045</fontSize>
			<color>2de2e6ff</color>
			<backgroundColor>00000000</backgroundColor>
			<zIndex>30</zIndex>
		</text>
		<helpsystem name="help">
			<textColor>d4ccffff</textColor>
			<iconColor>d4ccffff</iconColor>
		</helpsystem>
	</view>
	<view name="basic, detailed">
		<image name="background" extra="true">
			<path>./_art/bg.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="stripe" extra="true">
			<path>./_art/bar.png</path>
			<pos>0.05 0.15</pos>
			<size>0.9 0.008</size>
			<zIndex>5</zIndex>
		</image>
		<text name="logoText">
			<pos>0.05 0.06</pos>
			<size>0.9 0.08</size>
			<fontPath>./_art/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<color>ffd23fff</color>
			<alignment>left</alignment>
			<zIndex>10</zIndex>
		</text>
		<textlist name="gamelist">
			<pos>0.05 0.2</pos>
			<size>0.9 0.3</size>
			<selectorColor>ff2e88ff</selectorColor>
			<selectedColor>1b1446ff</selectedColor>
			<primaryColor>ece6ffff</primaryColor>
			<secondaryColor>2de2e6ff</secondaryColor>
			<fontPath>./_art/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.035</fontSize>
			<lineSpacing>1.8</lineSpacing>
			<alignment>left</alignment>
			<horizontalMargin>0.01</horizontalMargin>
			<zIndex>20</zIndex>
		</textlist>
		<text name="md_description">
			<pos>0.05 0.56</pos>
			<size>0.9 0.3</size>
			<fontSize>0.04</fontSize>
			<color>d4ccffff</color>
			<zIndex>20</zIndex>
		</text>
		<helpsystem name="help">
			<textColor>d4ccffff</textColor>
			<iconColor>d4ccffff</iconColor>
		</helpsystem>
	</view>
</theme>
